# Application
APP_NAME=Today's Mandi Prices API
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
# --- Option A: PostgreSQL via pgAdmin ---
# Do NOT add ?schema=public (that is Prisma-only, breaks psycopg2)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mandi_prices
# DATABASE_URL=postgresql://mandi_user:mandi_pass@localhost:5432/mandi_prices

# --- Option B: SQLite (works immediately, no pgAdmin needed) ---
DATABASE_URL=sqlite:///./mandi_prices.db

# Redis (optional caching layer)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Government API (data.gov.in Agmarknet)
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce57746370fffc958d3611
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# Cache TTL in seconds (1 hour — matches sync interval)
CACHE_TTL_SECONDS=3600

# Hourly price sync from Agmarknet
SYNC_INTERVAL_SECONDS=3600
SYNC_ENABLED=true
# Optional: protect /api/v1/sync/run for external cron (cron-job.org)
# SYNC_API_KEY=your-secret-key

# CORS — add custom domain(s), comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://dailymandiupdate.naliniudyogsamuh.com

# JWT (optional)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
